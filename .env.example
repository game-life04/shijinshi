# 复制为 .env.local 后填写。不填 LLM_API_KEY 时使用确定性模拟器（结果不能当实验数据）。
# 密钥只放在服务端环境变量里，不要提交到仓库，也不要写进前端代码。

# OpenAI 兼容接口地址（默认阿里云百炼北京区）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# 各角色使用的模型（开工前做小样本能力与价格测试后再锁定）
SUBJECT_MODEL=qwen-flash
TESTER_MODEL=qwen-plus
JUDGE_MODEL=qwen-plus
GUARD_MODEL=qwen-flash

# 单次模型调用超时（毫秒）
LLM_TIMEOUT_MS=30000

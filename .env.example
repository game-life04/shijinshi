# 复制为 .env.local 后填写。不填 LLM_API_KEY 时使用确定性模拟器（结果不能当实验数据）。
# 密钥只放在服务端环境变量里，不要提交到仓库，也不要写进前端代码。

# OpenAI 兼容接口地址（默认阿里云百炼北京区）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# 各角色使用的模型（10-19 真实试跑后选定，见 docs/pilot-log.md）
SUBJECT_MODEL=qwen-flash
TESTER_MODEL=qwen-plus
JUDGE_MODEL=qwen-plus
GUARD_MODEL=qwen-flash
# 备用模型（可选，ADR-043）：主模型限流、出错或超时时换它再试一次；不设就不换。
# 上线演示可以设；做对照实验时不要设（换过模型的调用次数记在运行清单 usage.fallback_calls）。
# GUARD_FALLBACK_MODEL=qwen-plus
# JUDGE_FALLBACK_MODEL=qwen-max
# TESTER_FALLBACK_MODEL=qwen-max
# SUBJECT_FALLBACK_MODEL=qwen-plus

# 单次模型调用超时（毫秒）
LLM_TIMEOUT_MS=30000

# 语音合成（工作台勾选「语音播放」时使用）。
# 不填时：有百炼密钥就用百炼 Qwen-TTS，否则用「模拟发声」（不是真人声音，结果标为模拟）。
# 百炼 Qwen-TTS 已于 10-27 用真实密钥跑通（ADR-020）。
# TTS_PROVIDER=dashscope            # dashscope 或 simulated
# TTS_MODEL=qwen3-tts-flash
# TTS_VOICE=Cherry
# TTS_API_KEY=                      # 不填就用 LLM_API_KEY
# TTS_TIMEOUT_MS=20000

# 上线演示：账号登录和次数上限（ADR-032，取代 ADR-028 的访问码；步骤见 docs/deploy.md）。本机开发、评委在自己电脑上运行时都不用设。
# 账号由参赛队分配，不开放注册；只存密码的哈希。每个账号的记录用 npx tsx scripts/account.ts add <账号名> 生成，改完重启服务。
# AUTH_ACCOUNTS、SESSION_SECRET、ACCESS_CODE 三个都不设：不登录、默认不限流。设了任何一个就要登录；缺什么、哪一条写错了，
# 全站拦住，原因写在服务端日志里（npx tsx scripts/account.ts check 也能查）。
# 填了 LLM_API_KEY 或 TTS_API_KEY（接了真实模型）却没配账号时，只许从本机（127.0.0.1、localhost）打开，别的地址一律拦住。
#
# 账号：一条「账号名:记录」，条与条之间用英文逗号隔开写成一行；要一行一条，就用英文双引号把整段括起来，块里 # 开头的行是注释：
# AUTH_ACCOUNTS=<账号名>:s1.15.8.3.<22位盐>.<43位哈希>,<账号名>:s1.15.8.3.<22位盐>.<43位哈希>
# AUTH_ACCOUNTS="
# <账号名>:s1.15.8.3.<22位盐>.<43位哈希>
# <账号名>:s1.15.8.3.<22位盐>.<43位哈希>
# "
# SESSION_SECRET=                    # 签登录 cookie 的密钥：配了账号就必填，至少 32 个字符，用 npx tsx scripts/account.ts secret 生成
# SESSION_TTL_HOURS=168              # 登录一次管多久（小时），最多 720
# AUTH_REVIEWERS=team-a,team-b        # 能做人工复核的账号（逗号隔开）；不设时所有账号都能复核。发给评委的账号不写进来，评委就只能看
# RATE_LIMIT=                        # 1 强制开限流，0 关（登录的两项照样限）；不填时：配了账号就开
# RATE_RUNS_PER_HOUR=10              # 同一账号每小时最多新建几次体检（没配账号、用 RATE_LIMIT=1 硬开时按来源算）
# RATE_RUNS_PER_DAY=100              # 全站每天最多新建几次体检（北京时间零点清零）
# RATE_PLAY_STARTS_PER_HOUR=30       # 同一账号每小时最多开几局闯关
# RATE_PLAY_TURNS_PER_HOUR=120       # 同一账号每小时最多在闯关里说几句
# RATE_PLAY_TURNS_PER_DAY=3000       # 全站每天闯关最多说几句
# RATE_LOGIN_PER_10MIN=10            # 同一来源每 10 分钟最多试几次登录
# RATE_LOGIN_FAILS_PER_15MIN=30      # 同一账号名每 15 分钟最多输错几次（不管从哪来）；要大于 20，不然一个来源就能把别人的账号锁住
# CLIENT_IP_HEADER=x-forwarded-for   # 从哪个请求头认来源；前面有 nginx 时改成 x-real-ip
# ACCESS_CODE 已经停用：只设了它、没配账号，会被当成配置错误拦住。AUTH_ALLOW_E2E_ACCOUNTS 只给端到端测试用，线上不要设。

# 角色 VRM 模型地址（默认 /models/qiyetao.vrm，见 public/models/README.md；改了要重新构建）
# NEXT_PUBLIC_VRM_URL=/models/qiyetao.vrm
